# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@host:5432/parts"

# ── Sessions ──────────────────────────────────────────────────────────────────
# At least 32 characters. Signs the marketplace's own login cookie.
SESSION_SECRET=""

# Shared with the booking portal. The portal signs a short-lived token with
# this; the marketplace verifies it and lets staff straight in, so there is no
# second password for the office to remember. Must match the portal's value.
PARTS_LINK_SECRET=""

# ── Storage (part photos) ─────────────────────────────────────────────────────
# local = disk (dev/test only — ephemeral). s3 = production.
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR=""
S3_BUCKET=""
S3_REGION="ca-central-1"

# ── Email ─────────────────────────────────────────────────────────────────────
# Pick-list emails to head office and drop-ship POs to suppliers.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
# Where head-office orders go when no FulfillmentContact row overrides it.
FULFILLMENT_EMAIL=""
